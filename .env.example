# demo — локальный прогон без Telegram
# live — сбор с публичных страниц t.me/s и публикация ботом
APP_MODE=demo

# Токен от @BotFather. Нужен только в режиме live.
BOT_TOKEN=

# Куда публиковать уникальные новости: @my_channel или числовой id
TARGET_CHANNEL=

# Каналы-источники через запятую (без @). В demo можно оставить пустым.
SOURCE_CHANNELS=

# Порог похожести 0..1. Чем выше, тем меньше ложных дублей.
SIMILARITY_THRESHOLD=0.82

# Как часто опрашивать источники в секундах
POLL_INTERVAL_SECONDS=90

# Не публиковать посты короче N символов
MIN_TEXT_LENGTH=40

# Окно сравнения: сколько последних постов держать в памяти дедупа
DEDUP_WINDOW=400

DATABASE_URL=sqlite:///./data/aggregator.db

# Ключ входа на сайт. Тот же ключ уходит в заголовке X-Auth-Key.
AUTH_KEY=toxic

# Необязательно: user-session через Telethon для закрытых каналов по invite-ссылке.
# API ID и Hash можно также ввести в админке (блок «Закрытые каналы»).
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_PATH=data/telegram_user
